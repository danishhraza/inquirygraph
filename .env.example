# OpenRouter (required for LLM calls)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model IDs on OpenRouter
LLM_MAIN_MODEL=deepseek/deepseek-v4-flash-0731
LLM_FAST_MODEL=qwen/qwen3-30b-a3b-instruct-2507

# Optional: Tavily for better web search (falls back to DuckDuckGo if empty)
TAVILY_API_KEY=

# Infrastructure (defaults match docker-compose)
POSTGRES_URL=postgresql://inquiry:inquiry@localhost:5432/inquirygraph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=inquirygraph
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=evidence_chunks

# Agent limits
MAX_RESEARCH_ITERATIONS=2
MAX_WEB_RESULTS=5
MAX_SOURCES_PER_TASK=2
MAX_TOTAL_SOURCES=1
MAX_TASKS_PER_PLAN=5
ENABLE_RERANKING=false
RETRIEVAL_STRATEGY=hybrid
PROCESSING_MODE=async

# API
API_HOST=0.0.0.0
API_PORT=8000
